# --- OpenRouter -------------------------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_DEFAULT_MODEL=google/gemini-3-flash-preview
OPENROUTER_APP_TITLE=PM Assistant
OPENROUTER_APP_URL=http://localhost:5173

# --- Smithery (hosted MCP gateway) ------------------------------------------
# Single API key for every integration. OAuth for Jira / GitHub / Slack /
# Notion / Linear / Gmail / Google Calendar / Figma / Confluence is completed
# in the browser via Settings -> Integrations -> Connect; never set per-service
# tokens here.
# https://smithery.ai -> Account -> API Keys
SMITHERY_API_KEY=
SMITHERY_NAMESPACE=pm-assistant

# --- Database (SQLite path relative to backend dir) -------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/pm.db

# --- Telegram bridge (optional) ---------------------------------------------
# Talk to the same agent from Telegram. Create a bot with @BotFather, paste
# the token below, then pair from Settings -> Telegram gateway.
TELEGRAM_BOT_TOKEN=
# Optional: restrict the bot to a single Telegram chat id.
# TELEGRAM_ALLOWED_CHAT_ID=

# --- Advanced (rarely needed) -----------------------------------------------
# Override the Smithery API base for self-hosted deployments.
# SMITHERY_API_BASE=https://api.smithery.ai
